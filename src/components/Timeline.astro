---
/**
 * Merges EXPERIENCE and EDUCATION -- same shape, see site.ts -- into one
 * chronological vertical timeline. Signature #1 (ledger) and #2 (marginalia)
 * are the site's established identity; this is a third: a single accent
 * line with small node markers, work solid and education outlined.
 *
 * From 48rem up the line runs down the CENTRE and entries alternate sides --
 * newest on the left. Side is derived from the index, so a new entry keeps the
 * zig-zag going with no markup change. Below 48rem it collapses to the original
 * single column with the line on the left.
 */
import { EXPERIENCE, EDUCATION } from '../data/site';

type Entry = (typeof EXPERIENCE)[number] | (typeof EDUCATION)[number];

const entries: (Entry & { kind: 'work' | 'education' })[] = [
  ...EXPERIENCE.map((e) => ({ ...e, kind: 'work' as const })),
  ...EDUCATION.map((e) => ({ ...e, kind: 'education' as const })),
].sort((a, b) => (a.start < b.start ? 1 : a.start > b.start ? -1 : 0));
---

<ol class="timeline" data-draw>
  {
    entries.map((entry, i) => (
      <li class="timeline__item" data-side={i % 2 === 0 ? 'left' : 'right'}>
        <span
          class="timeline__node"
          data-kind={entry.kind}
          aria-hidden="true"
        />
        <div class="timeline__entry" data-reveal>
          <div class="timeline__meta">
            <p class="timeline__period">{entry.period}</p>
            <span class="timeline__badge" data-current={entry.duration === 'Current'}>
              {entry.duration}
            </span>
            <span class="timeline__badge">
              {entry.kind === 'work' ? 'Work' : 'Education'}
            </span>
          </div>
          <h3 class="timeline__title">{entry.title}</h3>
          <p class="timeline__org">{entry.org}</p>
          {entry.highlights.length > 0 && (
            <ul class="timeline__highlights">
              {entry.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
          <ul class="timeline__tags" aria-label="Tags">
            {entry.tags.slice(0, 3).map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: var(--space-l);
    padding-inline-start: var(--space-l);
    margin-block-start: var(--space-m);
  }

  /* The vertical line. Drawn by [data-draw] in motion.css on scroll-in;
     fully visible by default so nothing depends on the animation running. */
  .timeline::before {
    content: '';
    position: absolute;
    inset-inline-start: 5px;
    inset-block: 0.4em 0;
    inline-size: 1px;
    background-color: var(--accent);
    transform-origin: top;
  }

  /* One row per entry. Below 48rem it is a plain block and the node hangs off
     its left edge, exactly as before; from 48rem up it becomes a 3-column grid
     (see the media query at the end of this block). */
  .timeline__item {
    position: relative;
  }

  /* Each entry is a glass card: the text has to read over a moving sky. */
  .timeline__entry {
    position: relative;
    display: grid;
    gap: var(--space-3xs);
    padding: var(--space-s) var(--space-m);
    background-color: var(--glass);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    box-shadow: var(--elevation);
  }

  .timeline__node {
    position: absolute;
    inset-inline-start: calc(-1 * var(--space-l) - 1px);
    inset-block-start: calc(var(--space-s) + 0.35em);
    inline-size: 11px;
    block-size: 11px;
    border-radius: 50%;
  }
  .timeline__node[data-kind='work'] {
    background-color: var(--accent);
    box-shadow: var(--glow);
  }
  .timeline__node[data-kind='education'] {
    background-color: var(--surface);
    border: 1px solid var(--accent);
  }

  .timeline__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }
  .timeline__period {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }
  /* Compact status pills -- same outlined-tag language as the project
     card's status label, so "Current" reads as a state, not just a word. */
  .timeline__badge {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-subtle);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    padding: 1px var(--space-xs);
  }
  .timeline__badge[data-current='true'] {
    color: var(--accent);
    border-color: var(--accent);
  }

  .timeline__title {
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    margin-block-start: var(--space-2xs);
  }
  .timeline__org {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-subtle);
  }

  /* Short phrases, not sentences -- a scorecard, not a paragraph. */
  .timeline__highlights {
    margin-block-start: var(--space-2xs);
    list-style: none;
    display: grid;
    gap: var(--space-3xs);
    max-inline-size: var(--measure);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
  .timeline__highlights li {
    padding-inline-start: 1.1em;
    position: relative;
  }
  .timeline__highlights li::before {
    content: '›';
    position: absolute;
    inset-inline-start: 0;
    color: var(--accent);
  }

  .timeline__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-2xs);
    margin-block-start: var(--space-2xs);
  }
  .timeline__tags li {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-muted);
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    padding: 2px var(--space-xs);
  }

  /* ------------------------------------------------------------ 48rem and up
     Centre line, alternating sides. Only POSITION changes here: colours, glass,
     radius, shadow, badges and chips are untouched. */
  @media (width >= 48rem) {
    .timeline {
      /* The line is centred on the content box, so side padding must be
         symmetric. The margin/padding pair keeps the cards where they were
         while giving overflow-x: clip a boundary out at the page gutter -- the
         slide-in below starts a little outside the resting position and must
         not be able to create a horizontal scrollbar. */
      padding-inline: var(--gutter);
      margin-inline: calc(var(--gutter) * -1);
      overflow-x: clip;
    }

    /* The line: dead centre, from the first node down to the end of the last
       card. (The original had no fade or gradient on it, so none is added;
       [data-draw] still draws it in on scroll.) */
    .timeline::before {
      inset-inline-start: 50%;
      translate: -50% 0;
      inset-block: calc(var(--space-s) + 0.35em + 5px) 0;
    }

    /* 1fr | node column | 1fr. The 5rem middle column puts each card 2.5rem
       from the line, and leaves each card just under half the container. */
    .timeline__item {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 5rem minmax(0, 1fr);
      align-items: start;
    }

    .timeline__node {
      position: relative;
      inset: auto;
      grid-column: 2;
      grid-row: 1;
      justify-self: center;
      /* Same offset the node always had from the top of its card. */
      margin-block-start: calc(var(--space-s) + 0.35em);
      z-index: 1;
    }

    .timeline__entry {
      grid-row: 1;
    }
    .timeline__item[data-side='left'] .timeline__entry {
      grid-column: 1;
    }
    .timeline__item[data-side='right'] .timeline__entry {
      grid-column: 3;
    }

    /* A short, subtle connector from the card's edge to its node, in the
       timeline's own line colour. It reaches the node's edge (5.5px radius). */
    .timeline__entry::before {
      content: '';
      position: absolute;
      inset-block-start: calc(var(--space-s) + 0.35em + 5px);
      inline-size: calc(2.5rem - 5px);
      block-size: 1px;
      background-color: var(--accent);
      opacity: 0.55;
    }
    .timeline__item[data-side='left'] .timeline__entry::before {
      inset-inline-end: calc((2.5rem - 5px) * -1);
    }
    .timeline__item[data-side='right'] .timeline__entry::before {
      inset-inline-start: calc((2.5rem - 5px) * -1);
    }

    /* Left cards hug the centre line: header block and chips right-aligned.
       The bullet list is deliberately left alone -- it stays left-aligned with
       its marker at the start of each line. */
    .timeline__item[data-side='left'] .timeline__meta,
    .timeline__item[data-side='left'] .timeline__tags {
      justify-content: flex-end;
    }
    .timeline__item[data-side='left'] .timeline__title,
    .timeline__item[data-side='left'] .timeline__org {
      text-align: end;
    }

    /* Entrance direction follows the side: left cards slide in from the left,
       right cards from the right. These feed the shared reveal in motion.css
       (scroll-driven, and the IntersectionObserver fallback). Opacity still
       fades; the old upward slide is replaced by the sideways one. */
    .timeline__item[data-side='left'] .timeline__entry {
      --reveal-x: -1.75rem;
      --reveal-shift: 0rem;
    }
    .timeline__item[data-side='right'] .timeline__entry {
      --reveal-x: 1.75rem;
      --reveal-shift: 0rem;
    }
  }
</style>
