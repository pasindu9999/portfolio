---
/**
 * The contact section's left-column info card: one icon tile + value per row,
 * on the same glass surface as the rest of the section. The icon replaces the
 * old mono text label; the label survives as visually hidden text so each row
 * keeps its accessible name.
 *
 * This used to also offer a copy-to-clipboard button next to the email,
 * revealed by a small scoped script. It now lives on the homepage, which
 * ships zero JavaScript, so the button was dropped -- the mailto link still
 * does the job.
 */
import { SITE } from '../data/site';
import Icon from './Icon.astro';

// Display forms. The full URLs stay in the hrefs; these just keep the mono
// values short enough not to touch the card edge on narrow screens.
const linkedinLabel = SITE.linkedin.replace(
  /^https?:\/\/(www\.)?linkedin\.com\//,
  '',
);
const githubLabel = SITE.github.replace(/^https?:\/\//, '');
---

<div class="contact-ledger glass">
  <dl>
    <div>
      <dt>
        <span class="contact-ledger__tile"><Icon name="mail" /></span>
        <span class="sr-only">Email</span>
      </dt>
      <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
    </div>
    <div>
      <dt>
        <span class="contact-ledger__tile"><Icon name="linkedin" /></span>
        <span class="sr-only">LinkedIn</span>
      </dt>
      <dd>
        <a href={SITE.linkedin} rel="noopener noreferrer" target="_blank">
          {linkedinLabel}<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </dd>
    </div>
    <div>
      <dt>
        <span class="contact-ledger__tile"><Icon name="github" /></span>
        <span class="sr-only">GitHub</span>
      </dt>
      <dd>
        <a href={SITE.github} rel="noopener noreferrer" target="_blank">
          {githubLabel}<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </dd>
    </div>
    <div>
      <dt>
        <span class="contact-ledger__tile"><Icon name="map-pin" /></span>
        <span class="sr-only">Location</span>
      </dt>
      <dd>{SITE.location}</dd>
    </div>
  </dl>
</div>

<style>
  /* Surface (border, radius, glass, shadow) comes from the shared .glass. */
  .contact-ledger {
    padding: var(--space-m);
  }
  .contact-ledger dl {
    display: grid;
    gap: var(--space-s);
  }
  .contact-ledger dl > div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-s);
    padding-block: var(--space-2xs);
    border-block-start: 1px solid var(--rule);
  }
  .contact-ledger dl > div:first-child {
    border-block-start: none;
    padding-block-start: 0;
  }
  .contact-ledger dl > div:last-child {
    padding-block-end: 0;
  }
  /* Accent at low opacity over the glass; the icon itself is currentColor, so
     it picks up --accent in whichever theme is active. */
  .contact-ledger__tile {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: var(--radius-s);
    color: var(--accent);
    background-color: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .contact-ledger dd {
    min-inline-size: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    overflow-wrap: anywhere;
  }
  .contact-ledger dd a {
    text-decoration-color: var(--rule-strong);
  }
  .contact-ledger dd a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
