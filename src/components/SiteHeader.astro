---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../data/site';

const NAV = [
  { href: '/#work', label: 'Work' },
  { href: '/#colophon', label: 'About' },
  { href: '/writing', label: 'Writing' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <a class="site-header__mark" href="/" aria-label={`${SITE.name} — home`}>
    <span class="site-header__first" aria-hidden="true">Udara</span>
    <span class="site-header__rest" aria-hidden="true">Kurukulasooriya</span>
  </a>

  <div class="site-header__end">
    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />

    <!-- Below 40rem the links live in a native popover: no JS to open it. -->
    <button
      class="site-header__menu-btn"
      type="button"
      popovertarget="site-menu"
      aria-label="Menu"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <nav id="site-menu" class="site-header__popover" popover aria-label="Primary (menu)">
    <ul>
      {
        NAV.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    --header-h: 4rem;
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-block-size: var(--header-h);
    padding: var(--space-2xs) var(--gutter);
  }

  /* The frosted layer is its own element so it can fade in on scroll without
     animating backdrop-filter itself. Always on by default (no scroll-driven
     animation support, or reduced motion): frosted from the first pixel. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--glass);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-block-end: 1px solid var(--glass-border);
    box-shadow: var(--elevation);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .site-header::before {
        animation: header-frost linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 120px;
      }
    }
  }

  @keyframes header-frost {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .site-header__mark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
    line-height: 1;
    color: var(--ink);
  }
  .site-header__first {
    color: var(--accent);
    text-shadow: var(--text-glow);
  }
  .site-header__rest {
    display: none;
  }
  @media (width >= 34rem) {
    .site-header__rest {
      display: inline;
    }
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .site-header__nav ul {
    display: none;
    gap: var(--space-m);
    list-style: none;
  }
  @media (width >= 40rem) {
    .site-header__nav ul {
      display: flex;
    }
  }

  .site-header__nav a {
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--ink-muted);
    transition: color var(--dur) var(--ease-out);
  }
  .site-header__nav a:hover {
    color: var(--accent);
  }

  /* --- Mobile menu button + popover --- */
  .site-header__menu-btn {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    background-color: var(--glass);
    color: var(--ink);
  }
  @media (width >= 40rem) {
    .site-header__menu-btn {
      display: none;
    }
  }

  .site-header__popover {
    position: fixed;
    inset: calc(var(--header-h) + 0.25rem) var(--gutter) auto auto;
    margin: 0;
    min-inline-size: 12rem;
    padding: var(--space-xs);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    /* Opaque-ish: the popover sits over live content, so it needs to read
       without backdrop blur on every device. */
    background-color: var(--surface-raised);
    color: var(--ink);
    box-shadow: var(--elevation);
  }
  .site-header__popover ul {
    display: grid;
    gap: var(--space-3xs);
    list-style: none;
  }
  .site-header__popover a {
    display: block;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-s);
    text-decoration: none;
  }
  .site-header__popover a:hover {
    background-color: var(--glass);
    color: var(--accent);
  }
</style>

<script>
  // A same-page hash link does not navigate away, so the popover would stay
  // open over the section it just scrolled to. Close it on any link click.
  const menu = document.getElementById('site-menu');
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) menu.hidePopover();
  });
</script>
