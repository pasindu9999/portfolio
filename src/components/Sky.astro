---
/**
 * The animated sky behind every page: two stacked scenes, one per theme.
 *
 *   .sky__night   deep indigo gradient, twinkling stars, shooting stars
 *   .sky__day     daytime gradient (clouds, sun and motes arrive in phase 3)
 *
 * Why it is built this way:
 *  - Star and meteor positions are generated HERE, at build time, with a
 *    seeded PRNG. The runtime ships no JS to place or re-place anything, the
 *    sky is identical on every page, and a window resize cannot reshuffle it.
 *  - Stars are not 200 elements. A layer is ONE tiny element whose
 *    box-shadow carries every dot, and the twinkle is an opacity animation on
 *    that layer -- a handful of compositor-only animations, not hundreds of
 *    nodes. Layers twinkle at different periods so the sky does not pulse in
 *    unison; a few individually animated "bright" stars carry the sparkle.
 *  - Everything animates transform/opacity only: no layout, no paint.
 *  - The scene that is not showing is paused, and everything pauses while the
 *    tab is hidden (script at the bottom).
 */

// mulberry32 -- tiny seeded PRNG so the layout is deterministic.
function rng(seed: number) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r2 = (n: number) => Math.round(n * 100) / 100;

const rand = rng(20260814);
const between = (lo: number, hi: number) => r2(lo + rand() * (hi - lo));

// Mostly white, a few starlight-blue and lavender so the field is not sterile.
const STAR_COLOURS = ['#ffffff', '#ffffff', '#ffffff', '#e8e9f6', '#cbbcff'];

/** box-shadow list for `n` dots scattered over the viewport. */
function dots(n: number, blur: number) {
  const out: string[] = [];
  for (let i = 0; i < n; i++) {
    // Skew slightly toward the top of the sky; the horizon is hazier.
    const y = r2(Math.pow(rand(), 1.25) * 100);
    const x = r2(rand() * 100);
    const colour = STAR_COLOURS[Math.floor(rand() * STAR_COLOURS.length)];
    out.push(`${x}vw ${y}vh ${blur}px 0 ${colour}`);
  }
  return out.join(',');
}

// id, dot count, dot size (px), blur (px), twinkle period (s)
const LAYERS = [
  { id: 'a1', n: 45, size: 1, blur: 0, dur: 3.1 },
  { id: 'a2', n: 45, size: 1, blur: 0, dur: 4.3 },
  { id: 'b1', n: 30, size: 2, blur: 0.5, dur: 4.7 },
  { id: 'b2', n: 25, size: 2, blur: 0.5, dur: 5.9 },
  { id: 'c', n: 22, size: 3, blur: 1, dur: 6.3 },
].map((l) => ({ ...l, shadow: dots(l.n, l.blur), delay: -between(0, l.dur) }));

const BRIGHT = Array.from({ length: 10 }, () => ({
  x: between(4, 96),
  y: between(3, 70),
  size: between(2.5, 4),
  dur: between(2.6, 5.4),
  delay: -between(0, 5),
}));

// Cycle lengths are deliberately uneven so the streaks never fall into step.
// Together they average roughly one meteor every 2.5s on desktop.
const METEORS = [
  { x: 62, y: 6, len: 130, dur: 11, delay: 2 },
  { x: 88, y: 22, len: 110, dur: 15, delay: 7 },
  { x: 45, y: 2, len: 150, dur: 10, delay: 4.5 },
  { x: 78, y: 40, len: 100, dur: 13, delay: 10 },
  { x: 30, y: 14, len: 120, dur: 16, delay: 6 },
];
---

<div class="sky" aria-hidden="true">
  <div class="sky__night">
    <div class="sky__nebula"></div>
    {
      LAYERS.map((l) => (
        <span
          class={`stars stars--${l.id}`}
          style={`--size:${l.size}px;--dur:${l.dur}s;--delay:${l.delay}s;box-shadow:${l.shadow}`}
        />
      ))
    }
    {
      BRIGHT.map((s, i) => (
        <span
          class:list={['star', { 'star--extra': i >= 6 }]}
          style={`--x:${s.x}%;--y:${s.y}%;--size:${s.size}px;--dur:${s.dur}s;--delay:${s.delay}s`}
        />
      ))
    }
    {
      METEORS.map((m, i) => (
        <span
          class:list={['meteor', { 'meteor--extra': i >= 3 }]}
          style={`--x:${m.x}%;--y:${m.y}%;--len:${m.len}px;--dur:${m.dur}s;--delay:${m.delay}s`}
        />
      ))
    }
  </div>

  <div class="sky__day"></div>
</div>

<style>
  .sky {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* Solid fallback while the scenes paint. */
    background-color: var(--surface);
  }

  .sky__night,
  .sky__day {
    position: absolute;
    inset: 0;
  }

  /* ---------------------------------------------------------------- scenes
     Day is the default (matches the light-first token defaults); dark flips
     it. The no-JS media block mirrors tokens.css. KEEP IN SYNC. */
  .sky__day {
    background: linear-gradient(
      to bottom,
      var(--day-blue),
      var(--day-lavender),
      var(--day-peach)
    );
  }

  .sky__night {
    background: linear-gradient(
      to bottom,
      var(--night-950),
      var(--night-900) 55%,
      var(--night-800)
    );
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 1.2s var(--ease-in-out),
      visibility 0s linear 1.2s;
  }
  .sky__day {
    transition: opacity 1.2s var(--ease-in-out);
  }

  :global([data-theme='dark']) .sky__night {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s, 0s;
  }
  :global([data-theme='dark']) .sky__day {
    opacity: 0;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .sky__night {
      opacity: 1;
      visibility: visible;
    }
    :global(:root:not([data-theme])) .sky__day {
      opacity: 0;
    }
  }

  /* Nothing animates in a scene nobody can see. */
  .sky__night :is(.stars, .star, .meteor) {
    animation-play-state: paused;
  }
  :global([data-theme='dark']) .sky__night :is(.stars, .star, .meteor) {
    animation-play-state: running;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .sky__night :is(.stars, .star, .meteor) {
      animation-play-state: running;
    }
  }

  /* A tab nobody is looking at pauses everything (see script). */
  :global([data-sky-paused]) .sky * {
    animation-play-state: paused !important;
  }

  /* ---------------------------------------------------------------- night */

  /* A faint violet glow at the horizon ties the sky to the accent colour. */
  .sky__nebula {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 90% 45% at 50% 108%,
        rgb(124 58 237 / 0.26),
        transparent 70%
      ),
      radial-gradient(
        ellipse 50% 35% at 12% 92%,
        rgb(91 47 208 / 0.14),
        transparent 70%
      );
  }

  /* One element per layer; its box-shadow carries every dot. */
  .stars {
    position: absolute;
    top: 0;
    left: 0;
    inline-size: var(--size);
    block-size: var(--size);
    border-radius: 50%;
    opacity: 0.85;
    will-change: opacity;
    animation: twinkle var(--dur) ease-in-out var(--delay) infinite alternate;
  }

  /* Individually animated stars: the sparkle. */
  .star {
    position: absolute;
    left: var(--x);
    top: var(--y);
    inline-size: var(--size);
    block-size: var(--size);
    border-radius: 50%;
    background-color: #fff;
    box-shadow:
      0 0 6px 1px rgb(255 255 255 / 0.7),
      0 0 16px 3px rgb(179 157 255 / 0.35);
    opacity: 0.9;
    animation: twinkle-bright var(--dur) ease-in-out var(--delay) infinite alternate;
  }

  /* A streak: a gradient bar, head at the left, flying down-left. Visible for
     the first ~10% of a long cycle, so they read as occasional, not looping. */
  .meteor {
    --travel: 42vmax;
    position: absolute;
    left: var(--x);
    top: var(--y);
    inline-size: var(--len);
    block-size: 2px;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      #fff,
      rgb(203 188 255 / 0.55) 35%,
      transparent
    );
    box-shadow: 0 0 8px 1px rgb(255 255 255 / 0.35);
    rotate: -30deg;
    opacity: 0;
    will-change: transform, opacity;
    animation: meteor var(--dur) linear var(--delay) infinite;
  }

  @keyframes twinkle {
    from {
      opacity: 0.45;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes twinkle-bright {
    from {
      opacity: 0.35;
      transform: scale(0.75);
    }
    to {
      opacity: 1;
      transform: scale(1.25);
    }
  }
  @keyframes meteor {
    0% {
      opacity: 0;
      transform: translateX(0);
    }
    1.5% {
      opacity: 1;
    }
    7% {
      opacity: 1;
    }
    10%,
    100% {
      opacity: 0;
      transform: translateX(calc(var(--travel) * -1));
    }
  }

  /* ---------------------------------------------------------------- mobile
     Fewer layers, fewer sparkles, fewer meteors. */
  @media (width < 48rem) {
    .stars--a2,
    .stars--b2,
    .star--extra,
    .meteor--extra {
      display: none;
    }
    .meteor {
      --travel: 60vmax;
    }
  }

  /* ---------------------------------------------------------- reduced motion
     Explicit, not the global 0.01ms hack: that would still flash a meteor once.
     Stars stay (static); anything that travels is removed. */
  @media (prefers-reduced-motion: reduce) {
    .stars,
    .star {
      animation: none;
      opacity: 0.85;
      transform: none;
    }
    .meteor {
      display: none;
    }
    .sky__night,
    .sky__day {
      transition: none;
    }
  }
</style>

<script>
  // Pause every sky animation while the tab is hidden.
  const root = document.documentElement;
  const sync = () => root.toggleAttribute('data-sky-paused', document.hidden);
  document.addEventListener('visibilitychange', sync);
  sync();
</script>
