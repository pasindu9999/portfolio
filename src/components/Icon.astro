---
/**
 * Small inline-SVG icon set, so the site needs no icon dependency.
 *
 * - mail, map-pin, code, sparkles, database: Tabler Icons (MIT), 24px stroke style.
 * - github, linkedin: Simple Icons (CC0), filled brand marks. Lucide dropped
 *   brand icons, which is why these two don't come from the same set.
 *
 * Everything paints with `currentColor`, so an icon follows whatever text
 * colour its parent sets in either theme. Icons are decorative (aria-hidden):
 * the parent link or row supplies the accessible name.
 */
const ICONS = {
  mail: {
    stroke: true,
    paths: [
      'M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z',
      'M3 7l9 6l9 -6',
    ],
  },
  'map-pin': {
    stroke: true,
    paths: [
      'M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0',
      'M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z',
    ],
  },
  code: {
    stroke: true,
    paths: ['M7 8l-4 4l4 4', 'M17 8l4 4l-4 4', 'M14 4l-4 16'],
  },
  sparkles: {
    stroke: true,
    paths: [
      'M16 18a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2m0 -12a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2m-7 12a6 6 0 0 1 6 -6a6 6 0 0 1 -6 -6a6 6 0 0 1 -6 6a6 6 0 0 1 6 6',
    ],
  },
  database: {
    stroke: true,
    paths: [
      'M12 6m-8 0a8 3 0 1 0 16 0a8 3 0 1 0 -16 0',
      'M4 6v6a8 3 0 0 0 16 0v-6',
      'M4 12v6a8 3 0 0 0 16 0v-6',
    ],
  },
  github: {
    stroke: false,
    paths: [
      'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
    ],
  },
  linkedin: {
    stroke: false,
    paths: [
      'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
    ],
  },
} as const;

interface Props {
  name: keyof typeof ICONS;
  /** Rendered edge length, in CSS units. */
  size?: string;
}

const { name, size = '1.25rem' } = Astro.props;
const icon = ICONS[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={icon.stroke ? 'none' : 'currentColor'}
  stroke={icon.stroke ? 'currentColor' : undefined}
  stroke-width={icon.stroke ? 2 : undefined}
  stroke-linecap={icon.stroke ? 'round' : undefined}
  stroke-linejoin={icon.stroke ? 'round' : undefined}
  aria-hidden="true"
  focusable="false"
>
  {icon.paths.map((d) => <path d={d} />)}
</svg>
