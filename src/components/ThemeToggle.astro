---
/**
 * Single sun/moon button.
 *
 * Storage contract (shared with ThemeScript.astro): key `theme` holds "light"
 * or "dark" ONLY. No key means "follow the system" -- a first click stores an
 * explicit choice, and `localStorage.removeItem('theme')` is the way back
 * (surfaced as "Use system theme" in the footer).
 *
 * The icon state is driven by CSS from the `data-theme` attribute on <html>,
 * not from component state, so it is right on first paint with no flash.
 */
---

<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-pressed="false"
  aria-label="Dark theme"
  title="Toggle light / dark"
>
  <svg
    class="theme-toggle__icon theme-toggle__sun"
    aria-hidden="true"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
  >
    <circle cx="12" cy="12" r="4.2"></circle>
    <path
      d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.35 5.35l1.55 1.55M17.1 17.1l1.55 1.55M18.65 5.35 17.1 6.9M6.9 17.1l-1.55 1.55"
    ></path>
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__moon"
    aria-hidden="true"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M20.2 14.6A8.4 8.4 0 0 1 9.4 3.8a8.4 8.4 0 1 0 10.8 10.8Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    background-color: var(--glass);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    color: var(--ink);
    transition:
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }
  .theme-toggle:hover {
    border-color: var(--accent);
    box-shadow: var(--glow);
  }

  /* Both icons occupy the same cell; the inactive one rotates and fades out.
     Sun shows in light theme (it is the thing you are looking at), moon in
     dark -- the icon reflects the current sky, the label says what it does. */
  .theme-toggle__icon {
    grid-area: 1 / 1;
    transition:
      opacity var(--dur-theme) var(--ease-out),
      rotate var(--dur-theme) var(--ease-out),
      scale var(--dur-theme) var(--ease-out);
  }
  .theme-toggle__sun {
    color: #b45309; /* amber 700 -- ~4.4:1 on the day glass (icon: needs 3:1) */
  }
  .theme-toggle__moon {
    color: var(--accent);
    opacity: 0;
    rotate: -60deg;
    scale: 0.6;
  }

  :global([data-theme='dark']) .theme-toggle__sun {
    opacity: 0;
    rotate: 60deg;
    scale: 0.6;
  }
  :global([data-theme='dark']) .theme-toggle__moon {
    opacity: 1;
    rotate: 0deg;
    scale: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-toggle__icon {
      transition: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'theme';
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');

  if (button) {
    const media = window.matchMedia('(prefers-color-scheme: dark)');

    const stored = (): 'light' | 'dark' | null => {
      try {
        const v = localStorage.getItem(STORAGE_KEY);
        return v === 'light' || v === 'dark' ? v : null;
      } catch {
        return null;
      }
    };

    const paint = (theme: 'light' | 'dark') => {
      root.setAttribute('data-theme', theme);
      root.style.colorScheme = theme;
      button.setAttribute('aria-pressed', String(theme === 'dark'));
    };

    const current = (): 'light' | 'dark' =>
      root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';

    // Sync aria-pressed with what the blocking head script already resolved.
    button.setAttribute('aria-pressed', String(current() === 'dark'));

    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        /* Storage unavailable -- the choice still applies for this page. */
      }
      paint(next);
    });

    // Track the OS while following it. Users expect this; almost nobody does it.
    media.addEventListener('change', () => {
      if (stored() === null) paint(media.matches ? 'dark' : 'light');
    });

    // "Use system theme" (footer) clears the key and dispatches this event.
    window.addEventListener('theme:reset', () => {
      paint(media.matches ? 'dark' : 'light');
    });
  }
</script>
