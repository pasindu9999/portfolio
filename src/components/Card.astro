---
/**
 * Shared frosted-glass card shell for skills and project cards. `category`
 * drives FilterGroup's show/hide.
 *
 * Elevation comes from tokens, so it is a soft lavender shadow by day and a
 * luminous hairline at night. Hover lifts the card and lights the border; the
 * lift is transform-only and skipped under reduced motion.
 */
interface Props {
  category?: string;
  class?: string;
}
const { category, class: className } = Astro.props;
---

<div class:list={['card', className]} data-category={category} data-reveal>
  <div class="card__body">
    <slot />
  </div>
</div>

<style>
  .card {
    display: block;
  }

  .card__body {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    background-color: var(--glass);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--elevation);
    padding: var(--space-s);
    height: 100%;
    transition:
      border-color var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .card__body:hover {
    border-color: var(--accent);
    box-shadow: var(--elevation-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card__body:hover {
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card__body {
      transition: none;
    }
  }
</style>
