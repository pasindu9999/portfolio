---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---

<ol class="ledger">
  {
    projects.map((project, i) => (
      <li class="ledger__row" data-reveal>
        <a class="ledger__link" href={`/work/${project.id}/`}>
          <span class="ledger__index" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>

          <h3
            class="ledger__title"
            style={`view-transition-name: work-${project.id}-title`}
          >
            {project.data.title}
          </h3>

          {/* Capped at three. A nine-tag project otherwise wraps to four
              lines and throws the whole row out of rhythm; the case study
              lists the full stack. */}
          <ul class="ledger__tags" aria-label="Stack">
            {project.data.tags.slice(0, 3).map((tag) => (
              <li>{tag}</li>
            ))}
            {project.data.tags.length > 3 && (
              <li class="ledger__tags-more">
                +{project.data.tags.length - 3}
              </li>
            )}
          </ul>

          <span class="ledger__year">{project.data.year}</span>
          <span class="ledger__arrow" aria-hidden="true">&#8594;</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .ledger {
    list-style: none;
    border-block-start: 1px solid var(--rule);
  }

  .ledger__row { border-block-end: 1px solid var(--rule); }

  .ledger__link {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-areas: 'index title year arrow';
    align-items: baseline;
    column-gap: var(--space-s);
    row-gap: var(--space-3xs);
    padding-block: var(--space-m);
    text-decoration: none;
    color: inherit;
    /* The baseline shift on hover. */
    transition:
      padding-inline-start var(--dur) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .ledger__index {
    grid-area: index;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-subtle);
    letter-spacing: 0.1em;
  }

  .ledger__title {
    grid-area: title;
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .ledger__tags {
    grid-area: tags;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-subtle);
  }
  .ledger__tags li::after { content: ' ·'; }
  .ledger__tags li:last-child::after { content: ''; }
  .ledger__tags-more { color: var(--accent); }

  .ledger__year {
    grid-area: year;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-subtle);
  }

  .ledger__arrow {
    grid-area: arrow;
    font-family: var(--font-mono);
    color: var(--accent);
    opacity: 0;
    translate: -0.5rem 0;
    transition:
      opacity var(--dur) var(--ease-out),
      translate var(--dur) var(--ease-out);
  }

  /* Hover personality: the row shifts off the grid line, the arrow ticks in. */
  .ledger__link:hover,
  .ledger__link:focus-visible {
    padding-inline-start: var(--space-s);
    color: var(--accent);
  }
  .ledger__link:hover .ledger__arrow,
  .ledger__link:focus-visible .ledger__arrow {
    opacity: 1;
    translate: 0 0;
  }

  @media (width >= 48rem) {
    .ledger__link {
      grid-template-columns: auto minmax(0, 1fr) minmax(0, 18rem) auto auto;
      grid-template-areas: 'index title tags year arrow';
    }
  }

  @media (width < 48rem) {
    .ledger__link {
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'index title arrow'
        '.     tags  year';
    }
    .ledger__title { font-size: var(--step-2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ledger__link,
    .ledger__arrow { transition: none; }
  }
</style>
