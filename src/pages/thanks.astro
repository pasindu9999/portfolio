---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Message sent"
  description="Thanks for getting in touch."
>
  <SiteHeader slot="header" />
  <SiteFooter slot="footer" />

  <section class="thanks">
    <p class="pill">Contact</p>
    <h1>Message <span>sent.</span></h1>
    <p class="measure">
      Thanks for reaching out. I read everything and reply to most messages
      within a couple of days.
    </p>
    <a class="btn btn--fill" href="/">Back to the index</a>
  </section>
</BaseLayout>

<style>
  .thanks {
    max-inline-size: 78rem;
    margin-inline: auto;
    padding: var(--space-3xl) var(--gutter);
    display: grid;
    gap: var(--space-s);
    justify-items: center;
    text-align: center;
    min-block-size: 60svh;
    align-content: center;
  }
  .thanks h1 { font-size: var(--step-5); letter-spacing: -0.04em; }
  .thanks h1 span { color: var(--accent); }
  .thanks .btn { justify-self: center; margin-block-start: var(--space-s); }
</style>
