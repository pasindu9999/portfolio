---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  const sorted = [...projects].sort((a, b) => a.data.order - b.data.order);

  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      index: i + 1,
      // Prev/next keeps the ledger navigable without going back to the index.
      next: sorted[(i + 1) % sorted.length],
    },
  }));
}

const { project, index, next } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<BaseLayout
  title={data.title}
  description={data.blurb}
  type="article"
>
  <SiteHeader slot="header" />
  <SiteFooter slot="footer" />

  <article class="case">
    <header class="case__head wrap">
      <p class="eyebrow">
        Case study {String(index).padStart(2, '0')} — {data.year}
      </p>
      <h1
        class="case__title"
        style={`view-transition-name: work-${project.id}-title`}
      >
        {data.title}
      </h1>
      <p class="case__blurb measure">{data.blurb}</p>
    </header>

    {/* The spec sheet: staggered hairline rows. */}
    <dl class="case__spec wrap">
      {data.context && (
        <div data-reveal><dt>Context</dt><dd>{data.context}</dd></div>
      )}
      <div data-reveal><dt>Role</dt><dd>{data.role}</dd></div>
      <div data-reveal><dt>Timeline</dt><dd>{data.timeline}</dd></div>
      <div data-reveal><dt>Stack</dt><dd>{data.tags.join(' · ')}</dd></div>
      <div data-reveal>
        <dt>Links</dt>
        <dd class="case__links">
          {
            data.repo && (
              <a href={data.repo} rel="noopener noreferrer" target="_blank">
                Source<span class="sr-only"> (opens in a new tab)</span>
              </a>
            )
          }
          {
            data.demo && (
              <a href={data.demo} rel="noopener noreferrer" target="_blank">
                Live demo<span class="sr-only"> (opens in a new tab)</span>
              </a>
            )
          }
          {!data.repo && !data.demo && <span>—</span>}
        </dd>
      </div>
    </dl>

    {data.cover && (
    <figure class="case__cover">
      <Picture
        src={data.cover}
        alt={data.coverAlt ?? data.title}
        formats={['avif', 'webp']}
        widths={[640, 1024, 1600, 2000]}
        sizes="(min-width: 78rem) 78rem, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    )}

    <div class="case__body wrap">
      <Content />
    </div>

    {
      next && next.id !== project.id && (
        <nav class="case__next wrap" aria-label="Next project">
          <a href={`/work/${next.id}/`}>
            <span class="eyebrow">Next case study</span>
            <span class="case__next-title">{next.data.title}</span>
            <span aria-hidden="true">→</span>
          </a>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .wrap {
    max-inline-size: 78rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .case__head {
    padding-block: var(--space-xl) var(--space-m);
  }
  .case__title {
    font-size: var(--step-6);
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin-block: var(--space-2xs) var(--space-s);
  }
  .case__blurb {
    font-size: var(--step-1);
    color: var(--ink-muted);
    line-height: 1.45;
  }

  .case__spec {
    display: grid;
    gap: 0;
    margin-block-end: var(--space-l);
  }
  .case__spec > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-s);
    padding-block: var(--space-2xs);
    border-block-start: 1px solid var(--rule);
  }
  .case__spec > div:last-child {
    border-block-end: 1px solid var(--rule);
  }
  /* Stagger the rows so the sheet assembles rather than appearing at once. */
  .case__spec > div:nth-child(1) { --reveal-shift: 0.6rem; }
  .case__spec > div:nth-child(2) { --reveal-shift: 0.9rem; }
  .case__spec > div:nth-child(3) { --reveal-shift: 1.2rem; }
  .case__spec > div:nth-child(4) { --reveal-shift: 1.5rem; }

  .case__spec dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-subtle);
  }
  .case__spec dd {
    font-size: var(--step--1);
  }
  .case__links {
    display: flex;
    gap: var(--space-s);
    font-family: var(--font-mono);
  }

  .case__cover {
    margin-block-end: var(--space-xl);
    max-inline-size: 78rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .case__cover :global(img) {
    inline-size: 100%;
    /* 3:2 rather than 16:9 -- the current covers are square, and a 16:9 crop
       cuts the top and bottom off them. Capped so a tall image cannot push
       the whole write-up below the fold. */
    aspect-ratio: 3 / 2;
    max-block-size: 70svh;
    object-fit: cover;
    object-position: center;
  }

  /* Long-form prose. Scoped styles do not reach <Content />, hence :global. */
  .case__body {
    max-inline-size: 46rem;
    margin-inline: auto;
  }
  .case__body :global(h2) {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    margin-block: var(--space-l) var(--space-s);
    padding-block-start: var(--space-2xs);
    border-block-start: 1px solid var(--rule);
  }
  .case__body :global(h3) {
    font-size: var(--step-1);
    margin-block: var(--space-m) var(--space-2xs);
  }
  .case__body :global(p) {
    margin-block-end: var(--space-s);
  }
  .case__body :global(ul),
  .case__body :global(ol) {
    margin-block-end: var(--space-s);
    padding-inline-start: var(--space-m);
  }
  .case__body :global(li) {
    margin-block-end: var(--space-3xs);
  }
  .case__body :global(blockquote) {
    border-inline-start: 2px solid var(--accent);
    padding-inline-start: var(--space-s);
    margin-block: var(--space-m);
    color: var(--ink-muted);
  }
  .case__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background-color: var(--surface-sunken);
    padding: 0.1em 0.35em;
  }
  .case__body :global(pre) {
    background-color: var(--surface-sunken);
    padding: var(--space-s);
    overflow-x: auto;
    margin-block-end: var(--space-s);
  }
  .case__body :global(pre code) {
    background: none;
    padding: 0;
  }

  .case__next {
    margin-block-start: var(--space-2xl);
  }
  .case__next a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--space-2xs);
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--rule);
    text-decoration: none;
    transition: padding-inline-start var(--dur) var(--ease-out);
  }
  .case__next a:hover {
    padding-inline-start: var(--space-s);
    color: var(--accent);
  }
  .case__next-title {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: var(--step-3);
    letter-spacing: -0.03em;
  }
  .case__next .eyebrow {
    grid-column: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .case__next a {
      transition: none;
    }
  }
</style>
