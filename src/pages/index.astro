---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MarginaliaIndex from '../components/MarginaliaIndex.astro';
import FilterGroup from '../components/FilterGroup.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillCard from '../components/SkillCard.astro';
import Timeline from '../components/Timeline.astro';
import ContactLedger from '../components/ContactLedger.astro';
import ContactAvailability from '../components/ContactAvailability.astro';
import Icon from '../components/Icon.astro';
import { PROJECT_CATEGORY } from '../content.config';
import { SITE, SKILLS, SKILL_CATEGORIES } from '../data/site';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const selected = projects.find((p) => p.data.featured) ?? projects[0];
const year = new Date().getFullYear();

// Only offer gallery tabs for categories actually present, in schema order.
const presentCategories = new Set(projects.map((p) => p.data.category));
const workCategories = PROJECT_CATEGORY.filter((c) => presentCategories.has(c));

// All copy for the About section lives here.
const ABOUT = {
  heading: 'Engineer, end to end.',
  intro:
    'Software engineer with three years of full-stack experience delivering enterprise web applications across the .NET and TypeScript ecosystems, with recent hands-on specialisation in applied GenAI and LLM engineering.',
  note: 'I modernise long-lived systems without breaking what already works, and build new platform layers where the interesting problems are access control, data contracts and test coverage. The GenAI work is the same instinct pointed at a newer problem: measure first, then decide what to change.',
  highlights: [
    {
      icon: 'code',
      title: 'Full-Stack Engineering',
      text: 'Building enterprise web applications across .NET and TypeScript, from legacy modernisation to greenfield platforms.',
    },
    {
      icon: 'sparkles',
      title: 'GenAI & LLM Engineering',
      text: 'Applied RAG, parameter-efficient fine-tuning and multi-agent systems, measured before changed.',
    },
    {
      icon: 'database',
      title: 'API & Data Architecture',
      text: 'Relational data design, API contracts and access control backed by solid test coverage.',
    },
  ],
} as const;

const SECTIONS = [
  { id: 'index', label: 'Index' },
  { id: 'colophon', label: 'About' },
  { id: 'work', label: 'Work' },
  { id: 'selected', label: 'Selected' },
  { id: 'skills', label: 'Skills' },
  { id: 'timeline', label: 'Timeline' },
  { id: 'contact', label: 'Contact' },
];
---

<BaseLayout title={`${SITE.name} — ${SITE.role}`} description={SITE.description}>
  <SiteHeader slot="header" />
  <SiteFooter slot="footer" />

  <MarginaliaIndex sections={SECTIONS} />

  <!-- ============ 01 HERO ============ -->
  <section id="index" class="hero">
    <div class="hero__inner">
      <p class="pill hero__eyebrow">{SITE.role} &middot; {year}</p>

      <h1 class="hero__title">
        <span class="hero__line hero__line--1">
          Hi, I’m <span class="hero__first">Udara</span>
        </span>
        <span class="hero__line hero__line--2">Kurukulasooriya</span>
      </h1>

      <p class="hero__lede">{SITE.description}</p>

      <ul class="hero__facts" aria-label="At a glance">
        <li class="pill">Full-stack</li>
        <li class="pill">{SITE.location}</li>
        <li class="pill hero__status">Open to roles</li>
      </ul>

      <div class="hero__cta">
        <a class="btn btn--fill" href="#work">View My Work</a>
        <a class="btn" href="/cv.pdf">Download CV</a>
      </div>
    </div>

    <a class="hero__scroll" href="#work">
      <span>Scroll</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M6 13l6 6 6-6"></path>
      </svg>
    </a>
  </section>

  <!-- ============ 02 ABOUT (id stays "colophon": header/footer link to it) ============ -->
  <section id="colophon" class="section-block wrap">
    <header class="section-head">
      <p class="eyebrow">02 / About</p>
      <h2>About <span>Me</span></h2>
    </header>

    <div class="about">
      <div class="about__intro">
        <h3>{ABOUT.heading}</h3>
        <p>{ABOUT.intro}</p>
        <p class="about__note">{ABOUT.note}</p>
        <div class="about__cta">
          <a class="btn btn--fill" href="#contact">Get In Touch</a>
          <a class="btn" href="/cv.pdf" download>Download CV</a>
        </div>
      </div>

      <ul class="about__cards" aria-label="Areas of focus">
        {
          ABOUT.highlights.map((item) => (
            <li class="about__card glass">
              <span class="about__icon">
                <Icon name={item.icon} size="1.5rem" />
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ 03 WORK — the filterable gallery ============ -->
  <section id="work" class="section-block wrap">
    <header class="section-head">
      <p class="eyebrow">03 / Work</p>
      <h2>Selected <span>Work</span></h2>
    </header>
    <FilterGroup
      id="work-filter"
      label="Filter projects by category"
      options={workCategories.map((c) => ({ value: c, label: c }))}
    >
      <div class="work__grid">
        {
          projects.map((project, i) => (
            <ProjectCard project={project} index={i + 1} />
          ))
        }
      </div>
    </FilterGroup>
  </section>

  <!-- ============ 04 SELECTED — the deliberate grid break ============ -->
  {
    selected && selected.data.cover && (
      <section id="selected" class="selected">
        <div class="selected__media" data-reveal data-fit={selected.data.coverFit}>
          <Picture
            src={selected.data.cover}
            alt={selected.data.coverAlt ?? selected.data.title}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 64rem) 58vw, 100vw"
            loading="lazy"
          />
        </div>

        <div class="selected__body" data-reveal>
          <p class="eyebrow">04 / In focus</p>
          <h2 class="selected__title">{selected.data.title}</h2>
          <p class="measure">{selected.data.blurb}</p>
          <dl class="spec">
            {selected.data.context && (
              <div>
                <dt>Context</dt>
                <dd>{selected.data.context}</dd>
              </div>
            )}
            <div>
              <dt>Role</dt>
              <dd>{selected.data.role}</dd>
            </div>
            <div>
              <dt>Stack</dt>
              <dd>{selected.data.tags.join(' · ')}</dd>
            </div>
            <div>
              <dt>Timeline</dt>
              <dd>{selected.data.timeline}</dd>
            </div>
          </dl>
          <a class="btn" href={`/work/${selected.id}/`}>
            Read the case study <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  <!-- ============ 05 SKILLS — filterable, tag-field cards ============ -->
  <section id="skills" class="section-block wrap">
    <header class="section-head">
      <p class="eyebrow">05 / Skills</p>
      <h2>My <span>Toolkit</span></h2>
    </header>
    <FilterGroup
      id="skills-filter"
      label="Filter skills by category"
      options={SKILL_CATEGORIES.map((c) => ({ value: c, label: c }))}
    >
      <div class="grid-skills">
        {
          SKILLS.map((group) => (
            <SkillCard
              group={group.group}
              category={group.category}
              items={group.items}
            />
          ))
        }
      </div>
    </FilterGroup>
  </section>

  <!-- ============ 06 TIMELINE — experience + education, merged ============ -->
  <section id="timeline" class="section-block wrap">
    <header class="section-head">
      <p class="eyebrow">06 / Experience</p>
      <h2>Career <span>Timeline</span></h2>
    </header>
    <Timeline />
  </section>

  <!-- ============ 07 CONTACT ============ -->
  <section id="contact" class="section-block wrap">
    <header class="section-head">
      <p class="eyebrow">07 / Contact</p>
      <h2>Get in <span>Touch</span></h2>
    </header>

    <p class="contact__statement">
      {/* Astro trims the whitespace before an element, so the space is explicit. */}
      Let’s build something that{' '}<span class="contact__accent">actually ships.</span>
    </p>

    <div class="contact">
      <div class="contact__aside">
        <ContactLedger />
        <ContactAvailability />
      </div>

      {/*
        Netlify Forms: this must stay static markup. Netlify's build-time bot
        only detects forms present in the emitted HTML, so it must never move
        into a client-rendered island.
      */}
      <form
        class="contact__form glass"
        name="contact"
        method="POST"
        action="/thanks/"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="sr-only">
          <label
            >Leave this field empty <input name="bot-field" tabindex="-1" /></label
          >
        </p>

        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
          />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <button class="btn btn--fill" type="submit">Send</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    max-inline-size: 78rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    /* The header is sticky and takes its own 4rem, so the hero fills the rest
       of the first screen exactly. */
    min-block-size: calc(100svh - 4rem);
    padding: var(--space-xl) var(--gutter) var(--space-3xl);
    text-align: center;
  }
  .hero__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    max-inline-size: 56rem;
  }
  .hero__title {
    display: grid;
    gap: 0.05em;
    font-size: var(--step-anchor);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 700;
  }
  .hero__line {
    display: block;
    /* Long surname: never let it push past the viewport. */
    overflow-wrap: anywhere;
  }
  .hero__first {
    color: var(--accent);
    text-shadow: var(--text-glow);
  }
  .hero__lede {
    max-inline-size: 42rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
    list-style: none;
  }
  .hero__status {
    color: var(--accent);
    border-color: var(--accent);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    padding-block-start: var(--space-2xs);
  }
  .hero__scroll {
    position: absolute;
    inset-block-end: var(--space-m);
    inset-inline: 0;
    margin-inline: auto;
    inline-size: fit-content;
    display: grid;
    justify-items: center;
    gap: 2px;
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--ink-muted);
  }
  .hero__scroll svg {
    color: var(--accent);
  }

  /* Staggered load-in and the bouncing cue. Backwards fill: the start state
     applies only while the animation is pending, so if animation is
     unsupported or disabled the content is simply there. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__eyebrow,
    .hero__line--1,
    .hero__line--2,
    .hero__lede,
    .hero__facts,
    .hero__cta {
      animation: hero-in 0.7s var(--ease-out) backwards;
    }
    .hero__line--1 { animation-delay: 0.1s; }
    .hero__line--2 { animation-delay: 0.25s; }
    .hero__lede    { animation-delay: 0.4s; }
    .hero__facts   { animation-delay: 0.55s; }
    .hero__cta     { animation-delay: 0.7s; }
    .hero__scroll svg {
      animation: hero-bounce 1.8s ease-in-out infinite;
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }
  @keyframes hero-bounce {
    50% {
      transform: translateY(6px);
    }
  }

  /* ---------- Work gallery ---------- */
  .work__grid {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-m);
  }
  @media (width >= 48rem) {
    .work__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-l);
    }
  }
  @media (width >= 72rem) {
    .work__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---------- Selected: full-bleed asymmetric break ---------- */
  .selected {
    margin-block: var(--space-3xl);
    display: grid;
    gap: var(--space-m);
  }
  @media (width >= 64rem) {
    .selected {
      grid-template-columns: minmax(0, 58fr) minmax(0, 42fr);
      align-items: center;
      gap: var(--space-xl);
      padding-inline-end: var(--gutter);
    }
    /* Breaks the page wrapper and bleeds off the left edge. */
    .selected__media {
      margin-inline-start: calc(var(--gutter) * -1);
    }
  }
  .selected__media {
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: var(--elevation);
  }
  .selected__media :global(img) {
    inline-size: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }
  /* Screenshots keep their own proportions -- nothing is cropped, so there is
     no reason to force a ratio and letterbox the difference. */
  .selected__media[data-fit='contain'] :global(img) {
    object-fit: contain;
    background-color: var(--surface-sunken);
    aspect-ratio: auto;
  }
  .selected__media[data-fit='contain'] {
    border: 1px solid var(--rule);
  }
  .selected__body {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    padding-inline: var(--gutter);
  }
  @media (width >= 64rem) {
    .selected__body {
      padding-inline: 0;
    }
  }
  .selected__title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
  }

  /* ---------- Spec sheet ---------- */
  .spec {
    display: grid;
    gap: var(--space-2xs);
  }
  .spec > div {
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: var(--space-s);
    padding-block: var(--space-2xs);
    border-block-start: 1px solid var(--rule);
  }
  .spec dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-subtle);
  }
  .spec dd {
    font-size: var(--step--1);
    display: grid;
    gap: 2px;
  }

  /* ---------- Skills ---------- */
  .grid-skills {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-m);
  }
  @media (width >= 48rem) {
    .grid-skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-l);
    }
  }
  @media (width >= 72rem) {
    .grid-skills {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---------- About ---------- */
  .about {
    display: grid;
    gap: var(--space-l);
    align-items: center;
    margin-block-start: var(--space-l);
  }
  /* Intro left, cards right from 768px; one column (intro first) below. */
  @media (width >= 48rem) {
    .about {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xl);
    }
  }

  .about__intro {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }
  .about__intro h3 {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
  }
  .about__intro p {
    font-size: clamp(1.05rem, 1rem + 0.2vw, 1.15rem);
    line-height: 1.5;
    max-inline-size: 62ch;
    hyphens: auto;
    text-wrap: pretty;
  }
  /* Justified so both paragraphs share one flush left and right edge. Only
     where the column is wide enough: at ~340px (phones, two-column tablet)
     justification opens visible gaps between words, so those stay ragged. The
     last line of each paragraph stays left-aligned. */
  @media (width >= 64rem) {
    .about__intro p {
      text-align: justify;
      text-align-last: start;
    }
  }
  .about__note {
    color: var(--ink-muted);
  }
  .about__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-2xs);
  }

  .about__cards {
    display: grid;
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }
  /* Surface (border, radius, glass) comes from the shared .glass. */
  .about__card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-s);
    padding: var(--space-s);
    border-radius: 0.75rem;
  }
  .about__card:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: var(--elevation-hover);
  }
  @media (prefers-reduced-motion: no-preference) {
    .about__card {
      transition:
        transform var(--dur) var(--ease-out),
        border-color var(--dur) var(--ease-out),
        box-shadow var(--dur) var(--ease-out);
    }
    .about__card:hover {
      transform: translateY(-3px);
    }
  }
  .about__icon {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 50%;
    color: var(--accent);
    background-color: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .about__card h3 {
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .about__card p {
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  /* ---------- Contact ---------- */
  .contact__statement {
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    max-inline-size: 28ch;
    margin: calc(var(--space-s) * -1) auto var(--space-xl);
    text-wrap: balance;
  }
  .contact__accent {
    color: var(--accent);
  }

  .contact {
    display: grid;
    gap: var(--space-xl);
  }
  @media (width >= 64rem) {
    .contact {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
      /* Stretch (not start) so the aside column ends level with the form. */
      align-items: stretch;
    }
  }

  /* Left column: info card, then the availability card, which grows to take
     whatever height the form leaves -- no fixed heights. */
  .contact__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
  .contact__aside > :global(:last-child) {
    flex: 1;
  }

  .contact__form {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    padding: var(--space-m);
  }

  /* Buttons (.btn, .btn--fill) live in styles/components.css. */
</style>
