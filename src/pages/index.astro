---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MarginaliaIndex from '../components/MarginaliaIndex.astro';
import FilterGroup from '../components/FilterGroup.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillCard from '../components/SkillCard.astro';
import Timeline from '../components/Timeline.astro';
import ContactLedger from '../components/ContactLedger.astro';
import portrait from '../assets/portrait-about.jpeg';
import { PROJECT_CATEGORY } from '../content.config';
import { SITE, BIO, SKILLS, SKILL_CATEGORIES } from '../data/site';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const selected = projects.find((p) => p.data.featured) ?? projects[0];
const year = new Date().getFullYear();

// Only offer gallery tabs for categories actually present, in schema order.
const presentCategories = new Set(projects.map((p) => p.data.category));
const workCategories = PROJECT_CATEGORY.filter((c) => presentCategories.has(c));

const SECTIONS = [
  { id: 'index', label: 'Index' },
  { id: 'work', label: 'Work' },
  { id: 'selected', label: 'Selected' },
  { id: 'skills', label: 'Skills' },
  { id: 'timeline', label: 'Timeline' },
  { id: 'colophon', label: 'Colophon' },
  { id: 'contact', label: 'Contact' },
];
---

<BaseLayout title={`${SITE.name} — ${SITE.role}`} description={SITE.description}>
  <SiteHeader slot="header" docking />
  <SiteFooter slot="footer" />

  <MarginaliaIndex sections={SECTIONS} />

  <!-- ============ 01 MASTHEAD ============ -->
  <section id="index" class="masthead">
    <p class="eyebrow masthead__eyebrow">
      {SITE.role} — portfolio — {year}
    </p>

    <h1 class="masthead__anchor">
      <span class="masthead__line-1">Udara</span>
      <span class="masthead__line-2">Kurukula</span>
      <span class="masthead__line-3">sooriya</span>
    </h1>

    <div class="masthead__rail">
      <dl>
        <div><dt>Role</dt><dd>{SITE.role}</dd></div>
        <div><dt>Focus</dt><dd>Full-stack &middot; applied GenAI</dd></div>
        <div><dt>Based</dt><dd>{SITE.location}</dd></div>
        <div><dt>Status</dt><dd class="masthead__status">Open to roles</dd></div>
      </dl>
      <p class="masthead__intro measure">{BIO}</p>
    </div>
  </section>

  <!-- ============ 02 WORK — the filterable gallery ============ -->
  <section id="work" class="section-block wrap">
    <div class="rule-labelled">
      <span class="label">02 /</span><span class="label">Selected work</span>
    </div>
    <FilterGroup
      id="work-filter"
      label="Filter projects by category"
      options={workCategories.map((c) => ({ value: c, label: c }))}
    >
      <div class="work__grid">
        {
          projects.map((project, i) => (
            <ProjectCard project={project} index={i + 1} />
          ))
        }
      </div>
    </FilterGroup>
  </section>

  <!-- ============ 03 SELECTED — the deliberate grid break ============ -->
  {
    selected && selected.data.cover && (
      <section id="selected" class="selected">
        <div class="selected__media" data-reveal data-fit={selected.data.coverFit}>
          <Picture
            src={selected.data.cover}
            alt={selected.data.coverAlt ?? selected.data.title}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 64rem) 58vw, 100vw"
            loading="lazy"
          />
        </div>

        <div class="selected__body" data-reveal>
          <p class="eyebrow">03 / In focus</p>
          <h2 class="selected__title">{selected.data.title}</h2>
          <p class="measure">{selected.data.blurb}</p>
          <dl class="spec">
            {selected.data.context && (
              <div>
                <dt>Context</dt>
                <dd>{selected.data.context}</dd>
              </div>
            )}
            <div>
              <dt>Role</dt>
              <dd>{selected.data.role}</dd>
            </div>
            <div>
              <dt>Stack</dt>
              <dd>{selected.data.tags.join(' · ')}</dd>
            </div>
            <div>
              <dt>Timeline</dt>
              <dd>{selected.data.timeline}</dd>
            </div>
          </dl>
          <a class="btn" href={`/work/${selected.id}/`}>
            Read the case study <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  <!-- ============ 04 SKILLS — filterable, tag-field cards ============ -->
  <section id="skills" class="section-block wrap">
    <div class="rule-labelled">
      <span class="label">04 /</span><span class="label">Toolkit</span>
    </div>
    <FilterGroup
      id="skills-filter"
      label="Filter skills by category"
      options={SKILL_CATEGORIES.map((c) => ({ value: c, label: c }))}
    >
      <div class="grid-skills">
        {
          SKILLS.map((group) => (
            <SkillCard
              group={group.group}
              category={group.category}
              items={group.items}
            />
          ))
        }
      </div>
    </FilterGroup>
  </section>

  <!-- ============ 05 TIMELINE — experience + education, merged ============ -->
  <section id="timeline" class="section-block wrap">
    <div class="rule-labelled">
      <span class="label">05 /</span><span class="label">Timeline</span>
    </div>
    <Timeline />
  </section>

  <!-- ============ 06 COLOPHON ============ -->
  <section id="colophon" class="section-block wrap">
    <div class="rule-labelled">
      <span class="label">06 /</span><span class="label">Colophon</span>
    </div>

    <div class="colophon">
      <div class="colophon__portrait">
        <Picture
          src={portrait}
          alt={SITE.name}
          formats={['avif', 'webp']}
          widths={[320, 540, 800]}
          sizes="(min-width: 64rem) 22rem, 60vw"
          loading="lazy"
        />
      </div>
      <div class="colophon__copy">
        <h2>Engineer, end to end.</h2>
        <p class="measure">{BIO}</p>
        <p class="colophon__note measure">
          In practice that has meant two things at once: moving long-lived
          enterprise systems onto modern architecture without breaking what
          already works, and building new platform layers where the interesting
          problems are access control, data contracts and test coverage rather
          than screens. The GenAI work is the same instinct pointed at a newer
          problem — measure first, then decide what to change.
        </p>
        <a class="btn" href="/cv.pdf">Download CV</a>
      </div>
    </div>
  </section>

  <!-- ============ 07 CONTACT ============ -->
  <section id="contact" class="section-block wrap">
    <div class="rule-labelled">
      <span class="label">07 /</span><span class="label">Contact</span>
    </div>

    <h2 class="contact__statement">
      Let’s build<br />something that<br />
      <span class="contact__accent">actually ships.</span>
    </h2>

    <div class="contact">
      <ContactLedger />

      {/*
        Netlify Forms: this must stay static markup. Netlify's build-time bot
        only detects forms present in the emitted HTML, so it must never move
        into a client-rendered island.
      */}
      <form
        class="contact__form"
        name="contact"
        method="POST"
        action="/thanks/"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="sr-only">
          <label
            >Leave this field empty <input name="bot-field" tabindex="-1" /></label
          >
        </p>

        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
          />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <button class="btn btn--fill" type="submit">Send</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    max-inline-size: 78rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* ---------- Masthead ---------- */
  .masthead {
    position: relative;
    isolation: isolate;
    padding: var(--space-xl) var(--gutter) var(--space-2xl);
    max-inline-size: 90rem;
    margin-inline: auto;
  }
  /* A very low-opacity dot grid behind the hero, faded out toward the edges
     so it reads as texture rather than a pattern. Pure CSS, no image asset. */
  .masthead::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(circle, var(--texture) 1px, transparent 1.5px);
    background-size: var(--texture-size) var(--texture-size);
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);
  }
  .masthead__eyebrow {
    margin-block-end: var(--space-m);
  }

  .masthead__anchor {
    font-size: var(--step-anchor);
    line-height: 0.82;
    letter-spacing: -0.045em;
    font-weight: 500;
    text-transform: uppercase;
    display: grid;
  }
  /* The asymmetry. Three lines, each staggered off the last, with the final
     syllable dropping to the accent. Splitting the surname across two lines
     is also what keeps the longest line short enough never to overflow. */
  .masthead__line-1 {
    justify-self: start;
  }
  .masthead__line-2 {
    justify-self: center;
  }
  .masthead__line-3 {
    justify-self: end;
    color: var(--accent);
  }
  @media (width >= 48rem) {
    .masthead__line-2 {
      justify-self: end;
      padding-inline-end: 8%;
    }
    .masthead__line-3 {
      padding-inline-end: 0;
    }
  }

  .masthead__rail {
    margin-block-start: var(--space-xl);
    display: grid;
    gap: var(--space-m);
    border-block-start: 1px solid var(--rule);
    padding-block-start: var(--space-s);
  }
  @media (width >= 60rem) {
    .masthead__rail {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
  .masthead__rail dl {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
  }
  .masthead__rail dl > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-2xs);
  }
  .masthead__rail dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-subtle);
  }
  .masthead__rail dd {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .masthead__status {
    color: var(--accent);
  }
  .masthead__intro {
    font-size: var(--step-1);
    line-height: 1.45;
  }

  /* ---------- Work gallery ---------- */
  .work__grid {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-m);
  }
  @media (width >= 48rem) {
    .work__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-l);
    }
  }
  @media (width >= 72rem) {
    .work__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---------- Selected: full-bleed asymmetric break ---------- */
  .selected {
    margin-block: var(--space-3xl);
    display: grid;
    gap: var(--space-m);
  }
  @media (width >= 64rem) {
    .selected {
      grid-template-columns: minmax(0, 58fr) minmax(0, 42fr);
      align-items: center;
      gap: var(--space-xl);
      padding-inline-end: var(--gutter);
    }
    /* Breaks the page wrapper and bleeds off the left edge. */
    .selected__media {
      margin-inline-start: calc(var(--gutter) * -1);
    }
  }
  .selected__media :global(img) {
    inline-size: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }
  /* Screenshots keep their own proportions -- nothing is cropped, so there is
     no reason to force a ratio and letterbox the difference. */
  .selected__media[data-fit='contain'] :global(img) {
    object-fit: contain;
    background-color: var(--surface-sunken);
    aspect-ratio: auto;
  }
  .selected__media[data-fit='contain'] {
    border: 1px solid var(--rule);
  }
  .selected__body {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    padding-inline: var(--gutter);
  }
  @media (width >= 64rem) {
    .selected__body {
      padding-inline: 0;
    }
  }
  .selected__title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
  }

  /* ---------- Spec sheet ---------- */
  .spec {
    display: grid;
    gap: var(--space-2xs);
  }
  .spec > div {
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: var(--space-s);
    padding-block: var(--space-2xs);
    border-block-start: 1px solid var(--rule);
  }
  .spec dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-subtle);
  }
  .spec dd {
    font-size: var(--step--1);
    display: grid;
    gap: 2px;
  }

  /* ---------- Skills ---------- */
  .grid-skills {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-m);
  }
  @media (width >= 48rem) {
    .grid-skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-l);
    }
  }
  @media (width >= 72rem) {
    .grid-skills {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---------- Colophon ---------- */
  .colophon {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-l);
  }
  @media (width >= 64rem) {
    .colophon {
      grid-template-columns: 22rem minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: start;
    }
  }
  .colophon__portrait :global(img) {
    inline-size: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .colophon__copy {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    max-inline-size: var(--measure);
  }
  .colophon__copy h2 {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
  }
  .colophon__copy p {
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .colophon__note {
    color: var(--ink-muted);
  }

  /* ---------- Contact ---------- */
  .contact__statement {
    font-size: var(--step-5);
    letter-spacing: -0.04em;
    line-height: 0.98;
    margin-block: var(--space-2xs) var(--space-l);
  }
  .contact__accent {
    color: var(--accent);
  }

  .contact {
    display: grid;
    gap: var(--space-xl);
  }
  @media (width >= 64rem) {
    .contact {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  .contact__form {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  /* ---------- Buttons ---------- */
  .btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: none;
    padding: var(--space-2xs) var(--space-s);
    border: 1px solid var(--rule-strong);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .btn:hover {
    background-color: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }
  .btn--fill {
    background-color: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }
  .btn--fill:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
  }
</style>
