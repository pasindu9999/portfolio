---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Not found" description="That page does not exist.">
  <SiteHeader slot="header" />
  <SiteFooter slot="footer" />

  <section class="nf">
    <p class="pill">Error 404</p>
    <h1>4<span>0</span>4</h1>
    <p class="measure">That page does not exist — or it did, and does not now.</p>
    <a class="btn btn--fill" href="/">Back to the index</a>
  </section>
</BaseLayout>

<style>
  .nf {
    max-inline-size: 78rem;
    margin-inline: auto;
    padding: var(--space-3xl) var(--gutter);
    display: grid;
    gap: var(--space-s);
    justify-items: center;
    text-align: center;
    min-block-size: 60svh;
    align-content: center;
  }
  .nf h1 {
    font-size: var(--step-anchor);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  /* The zero is the moon: the one purple glyph. */
  .nf h1 span {
    color: var(--accent);
    text-shadow: var(--text-glow);
  }
  .nf .btn {
    justify-self: center;
    margin-block-start: var(--space-s);
  }
</style>
