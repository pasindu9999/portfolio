---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Not found" description="That page does not exist.">
  <SiteHeader slot="header" />
  <SiteFooter slot="footer" />

  <section class="nf">
    <p class="eyebrow">Error 404</p>
    <h1>404</h1>
    <p class="measure">That page does not exist — or it did, and does not now.</p>
    <a class="btn" href="/">Back to the index</a>
  </section>
</BaseLayout>

<style>
  .nf {
    max-inline-size: 78rem;
    margin-inline: auto;
    padding: var(--space-3xl) var(--gutter);
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    min-block-size: 60svh;
    align-content: center;
  }
  .nf h1 {
    font-size: var(--step-anchor);
    line-height: 0.82;
    letter-spacing: -0.05em;
    color: var(--accent);
  }
  .btn {
    display: inline-flex;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: none;
    padding: var(--space-2xs) var(--space-s);
    border: 1px solid var(--rule-strong);
    margin-block-start: var(--space-s);
  }
  .btn:hover { background-color: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
</style>
