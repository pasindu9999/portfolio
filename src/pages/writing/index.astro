---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<BaseLayout
  title="Writing"
  description="Notes on building software — architecture decisions, things that broke, and what I learned."
>
  <SiteHeader slot="header" />
  <SiteFooter slot="footer" />

  <section class="writing wrap">
    <p class="eyebrow">Writing</p>
    <h1 class="writing__title">Notes</h1>
    <p class="measure writing__intro">
      Short pieces on architecture decisions, things that broke, and what I
      took from them.
    </p>

    {
      posts.length === 0 ? (
        <p class="writing__empty mono">
          Nothing published yet. A dead blog with one stale post reads worse
          than no blog, so this stays empty until there is something worth
          reading here.
        </p>
      ) : (
        <ol class="ledger">
          {posts.map((post, i) => (
            <li class="ledger__row" data-reveal>
              <a class="ledger__link" href={`/writing/${post.id}/`}>
                <span class="ledger__index" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h2 class="ledger__title">{post.data.title}</h2>
                <p class="ledger__blurb">{post.data.blurb}</p>
                <time class="ledger__date" datetime={post.data.pubDate.toISOString()}>
                  {fmt.format(post.data.pubDate)}
                </time>
                <span class="ledger__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</BaseLayout>

<style>
  .wrap {
    max-inline-size: 78rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .writing {
    padding-block: var(--space-xl) var(--space-3xl);
    min-block-size: 60svh;
  }
  .writing__title {
    font-size: var(--step-6);
    letter-spacing: -0.04em;
    margin-block: var(--space-2xs) var(--space-s);
  }
  .writing__intro {
    font-size: var(--step-1);
    color: var(--ink-muted);
    margin-block-end: var(--space-xl);
  }
  .writing__empty {
    color: var(--ink-subtle);
    max-inline-size: var(--measure);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--rule);
  }

  .ledger {
    list-style: none;
    border-block-start: 1px solid var(--rule);
  }
  .ledger__row {
    border-block-end: 1px solid var(--rule);
  }
  .ledger__link {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-areas:
      'index title date arrow'
      '.     blurb blurb blurb';
    align-items: baseline;
    column-gap: var(--space-s);
    row-gap: var(--space-3xs);
    padding-block: var(--space-m);
    text-decoration: none;
    color: inherit;
    transition:
      padding-inline-start var(--dur) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .ledger__index {
    grid-area: index;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink-subtle);
    letter-spacing: 0.1em;
  }
  .ledger__title {
    grid-area: title;
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .ledger__blurb {
    grid-area: blurb;
    color: var(--ink-muted);
    max-inline-size: var(--measure);
    font-size: var(--step--1);
  }
  .ledger__date {
    grid-area: date;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-subtle);
  }
  .ledger__arrow {
    grid-area: arrow;
    font-family: var(--font-mono);
    color: var(--accent);
    opacity: 0;
    translate: -0.5rem 0;
    transition:
      opacity var(--dur) var(--ease-out),
      translate var(--dur) var(--ease-out);
  }
  .ledger__link:hover,
  .ledger__link:focus-visible {
    padding-inline-start: var(--space-s);
    color: var(--accent);
  }
  .ledger__link:hover .ledger__arrow,
  .ledger__link:focus-visible .ledger__arrow {
    opacity: 1;
    translate: 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .ledger__link,
    .ledger__arrow {
      transition: none;
    }
  }
</style>
